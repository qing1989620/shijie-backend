APP_ENV=development
APP_NAME=Shijie Learning Platform API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 开发默认 SQLite（backend/data/app.db）；生产使用 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://shijie:shijie@localhost:5432/shijie
DATABASE_URL=sqlite:///data/app.db
REDIS_URL=redis://localhost:6379/0

# 必须在生产中替换为 64+ 位随机串： python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# 前端开发服务器地址；生产替换为 https://learn.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider: mock | openrouter（无 Key 时自动回落 mock，系统完整可用）
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_MODEL=
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=60

# ASR Provider: mock | funasr（自托管，见 infra/asr）
ASR_PROVIDER=mock
ASR_BASE_URL=http://localhost:8100
ASR_MODEL=paraformer-zh

# OCR Provider: mock | paddleocr
OCR_PROVIDER=mock

# Embedding / Reranker（开发期 lexical 检索无需模型；接入 bge 时填 bge）
EMBEDDING_PROVIDER=lexical
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=none
RERANKER_MODEL=

# 对象存储: local | s3（生产 MinIO/S3/OSS）
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=shijie
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
